# Copy to .env and fill in. Never commit the filled-in version.
# .env is gitignored; this template is not.

# --- Waitlist (Mailchimp) ---
# Required for the waitlist form to work. Without these, subscribe throws.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DC=us3

# --- Database (MySQL) ---
# Optional in development. The app degrades gracefully without it: auth
# falls back to logged-out and a warning is logged rather than crashing.
DATABASE_URL=

# --- Sessions ---
# Signs the session cookie. Use a long random string, not a guessable one.
JWT_SECRET=

# --- OAuth (admin login only) ---
# The public site and waitlist work without these. /admin does not.
OAUTH_SERVER_URL=
VITE_APP_ID=
OWNER_OPEN_ID=

# --- Owner notifications ---
# Sends a message on each new waitlist signup. Optional; failures are
# caught and logged, and do not block the subscription.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# --- Analytics (optional) ---
# Referenced by client/index.html. Build warns when unset, which is harmless.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
