{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build && node scripts/prerender.mjs && esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
  "outputDirectory": "dist/public",
  "framework": null,
  "redirects": [
    {
      "source": "/mint",
      "destination": "/setup",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/agent",
      "destination": "/agent/index.html"
    },
    {
      "source": "/whitepaper",
      "destination": "/whitepaper/index.html"
    },
    {
      "source": "/docs",
      "destination": "/docs/index.html"
    },
    {
      "source": "/setup",
      "destination": "/setup/index.html"
    },
    {
      "source": "/legal",
      "destination": "/legal/index.html"
    },
    {
      "source": "/planner",
      "destination": "/planner/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/spa.html"
    }
  ]
}
